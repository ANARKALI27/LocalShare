#!/bin/sh
set -e

# Refresh the desktop entry and icon caches so LocalShare's icon and
# menu entry show up immediately rather than only after a logout/login.
# Both commands are best-effort: not every desktop environment has
# them, and that's fine — the files are already in place regardless.
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi

exit 0
